# goFlex — FlexRadio client configuration
#
# Copy this file to .env and edit the values for your setup.
# If .env is not present, the application uses built-in defaults.

# Radio IP address (default: 192.168.50.151)
RADIO_ADDRESS=192.168.50.151

# Radio TCP port (default: 4992)
RADIO_PORT=4992

# Maximum log entries to retain in the TUI (default: 500)
MAX_LOG=500
